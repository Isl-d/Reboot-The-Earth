# Copy to .env and adjust for the demo laptop. Never commit a real .env.
# Every value is optional: the platform degrades rather than refusing to start.

COLDCHAIN_MQTT_HOST=localhost
COLDCHAIN_MQTT_PORT=1883

# Leave empty to run without Postgres (falls back to SQLite).
COLDCHAIN_DATABASE_URL=postgresql+psycopg://coldchain:coldchain@localhost:5432/coldchain

# Leave empty to keep latest state in process memory instead of Redis.
COLDCHAIN_REDIS_URL=redis://localhost:6379/0

COLDCHAIN_API_HOST=0.0.0.0
COLDCHAIN_API_PORT=8100

# Simulator
COLDCHAIN_TICK_SECONDS=2.0
COLDCHAIN_SIM_SEED=7
