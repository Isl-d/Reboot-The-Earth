# Copy to .env and adjust for the demo laptop. Never commit .env.
# Wi-Fi credentials live in the firmware only - never here.

COLDGUARD_MQTT_HOST=localhost
COLDGUARD_MQTT_PORT=1883

COLDGUARD_DB_URL=postgresql://coldguard:coldguard@localhost:5432/coldguard
# Leave DB_URL empty to run fully in memory (demo still works, nothing persisted).

COLDGUARD_OLLAMA_URL=http://localhost:11434
COLDGUARD_OLLAMA_MODEL=qwen2.5:7b
COLDGUARD_OLLAMA_TIMEOUT_S=5

# Demo clock: 1 real second = 120 simulated seconds (2 minutes).
COLDGUARD_DEMO_SPEED=120
